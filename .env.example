# Public URL Ghost is configured with (the "url" in Ghost's config), NOT an internal
# address like http://ghost:2368: Ghost redirects those and the Admin API call fails.
GHOST_URL=https://blog.example.com

# Ghost Admin > Settings > Integrations > Add custom integration > Admin API key
# Format: <24 hex>:<64 hex>
GHOST_ADMIN_KEY=

# Shared secret that protects this MCP server. Generate with: openssl rand -hex 32
# Connector URL becomes https://<your-domain>/mcp/<MCP_SECRET>
MCP_SECRET=

# --- optional -----------------------------------------------------------------
# Minimum Ghost API version sent in the Accept-Version header.
# GHOST_API_VERSION=v5.0
# Only if the Admin API lives on a different domain than the site.
# GHOST_ADMIN_URL=
# Registers delete_ghost_post / _page / _tag tools. Off by default.
ENABLE_DELETE=false
# Registers member tools (personal data). Off by default.
# ENABLE_MEMBERS=false
# Registers only read tools, whatever the other flags say.
# READ_ONLY=false
# PORT=3000
# GHOST_TIMEOUT_MS=30000
# MAX_UPLOAD_BYTES=10485760
# Allow image downloads from private/loopback addresses (SSRF guard is on by default).
# ALLOW_PRIVATE_IMAGE_URLS=false
